<Window x:Class="WpfAppSuper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WpfAppSuper"
        mc:Ignorable="d"
        Title="Assignment2" Height="450" Width="800">
    <Grid>
        <Label Content="_First Name" HorizontalAlignment="Left" Margin="149,96,0,0" VerticalAlignment="Top" TabIndex="1" Target="{Binding ElementName=FirstBox}"/>
        <Label Content="_Last Name" HorizontalAlignment="Center" Margin="0,96,0,0" VerticalAlignment="Top" TabIndex="3" Target="{Binding ElementName=LastBox}"/>
        <Label Content="_Hours Worked" HorizontalAlignment="Left" Margin="544,96,0,0" VerticalAlignment="Top" TabIndex="5" Target="{Binding ElementName=HourBox}"/>
        <TextBox x:Name="FirstBox" HorizontalAlignment="Left" Margin="123,137,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" TextChanged="FirstBox_TextChanged" TabIndex="2"/>
        <TextBox x:Name="LastBox" HorizontalAlignment="Center" Margin="0,137,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" TextChanged="LastBox_TextChanged" TabIndex="4"/>
        <TextBox x:Name="HourBox" HorizontalAlignment="Left" Margin="527,137,0,0" TextWrapping="Wrap" Text="" VerticalAlignment="Top" Width="120" TextChanged="HourBox_TextChanged" TabIndex="6"/>
        <Button Content="_Summarize" HorizontalAlignment="Left" Margin="123,186,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.414,1.946" Click="Button_Click_Summarize" TabIndex="7"/>
        <Button Content="_Clear" HorizontalAlignment="Left" Margin="340,186,0,0" VerticalAlignment="Top" RenderTransformOrigin="0.53,-1.08" Click="Button_Click_Clear" TabIndex="8"/>
        <Rectangle HorizontalAlignment="Left" Height="106" Margin="123,251,0,0" Stroke="Black" VerticalAlignment="Top" Width="576" RenderTransformOrigin="0.503,0.717"/>
        <Label x:Name="SumLabel" Content="" Margin="183,286,140,0" VerticalAlignment="Top" RenderTransformOrigin="15.48,0.618" HorizontalContentAlignment="Center"/>


    </Grid>
</Window>
